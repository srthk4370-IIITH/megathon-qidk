{
  "version": 1,
  "asr": {
    "language_mode": "force_en",
    "max_chunk_s": 28,
    "min_speech_ratio": 0.1,
    "engine": "whisper_cpp",
    "whisper_cpp_model": "ggml-small-q5_1.bin",
    "max_narration_s": 30
  },
  "vad": {
    "start_threshold": 0.6,
    "end_threshold": 0.45,
    "end_silence_ms": 1200,
    "followup_end_silence_ms": 1000,
    "preroll_ms": 300,
    "no_speech_timeout_ms": 10000,
    "followup_no_speech_timeout_ms": 8000,
    "max_narration_s": 30
  },
  "llm": {
    "prefix_cache": false,
    "max_tokens": {
      "extract": 320,
      "patch": 120,
      "recommend": 260,
      "repair": 320
    },
    "samplers": {
      "greedy": {
        "version": 1,
        "seed": 42,
        "temp": 1.0,
        "top-k": 1,
        "top-p": 1.0
      },
      "recommend": {
        "version": 1,
        "seed": 42,
        "temp": 0.3,
        "top-k": 40,
        "top-p": 0.95
      }
    },
    "recommend_timeout_ms": 12000
  },
  "conversation": {
    "max_followup_rounds": 3,
    "transcript_autoproceed_ms": 2000,
    "tts_post_gap_ms": 300
  },
  "thermal": {
    "defer_background_above_c": 88,
    "skin_warn_above_c": 60
  },
  "models": {
    "llama_dir": "llama",
    "whisper_dir": "whisper",
    "dsp_dir": "dsp",
    "prompt_variant": "base"
  },
  "recommend": {
    "mode": "templates",
    "max_items": 6
  },
  "time": {
    "default_when_missing": "reported_at",
    "status": "DEFAULTED"
  },
  "features": {
    "response_clock": true,
    "quick_launch": true,
    "wake_word": true,
    "multi_witness": true
  },
  "response_clock": {
    "ert_reminder_s": 120
  },
  "wake_display": "Hey Qalam",
  "wake_variants": [
    "hey kalam",
    "hey qalam",
    "hey calum",
    "hey column",
    "hey calm",
    "hey kalam",
    "a kalam",
    "hey kallam"
  ],
  "wake_min_conf": 0.6,
  "multi_witness": {
    "time_window_min": 45,
    "lookback_h": 12,
    "min_location_score": 0.85,
    "min_score": 0.6
  }
}
