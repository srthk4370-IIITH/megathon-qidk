{
  "version": 1,
  "groups_order": [
    "type",
    "where_when",
    "impact",
    "victim",
    "hazard",
    "response"
  ],
  "common_fields": [
    {
      "key": "incident_type",
      "type": "enum_category",
      "mandatory": true,
      "group": "type",
      "priority": 1,
      "label": "Incident type",
      "q": {
        "en": "What kind of incident is this — for example a fire, a leak, an injury, or an equipment problem?",
        "hinglish": "Yeh kis type ka incident hai — jaise aag, leak, chot, ya machine ki problem?"
      }
    },
    {
      "key": "secondary_types",
      "type": "enum_category_list",
      "max_items": 2,
      "mandatory": false,
      "label": "Also involves"
    },
    {
      "key": "title",
      "type": "string",
      "max_len": 80,
      "mandatory": false,
      "system": true,
      "label": "Title"
    },
    {
      "key": "description",
      "type": "string",
      "mandatory": true,
      "group": "type",
      "priority": 2,
      "label": "Description",
      "q": {
        "en": "Could you briefly describe what happened?",
        "hinglish": "Thoda batayiye, exactly kya hua?"
      }
    },
    {
      "key": "location",
      "type": "string",
      "mandatory": true,
      "group": "where_when",
      "priority": 3,
      "label": "Location",
      "q": {
        "en": "Where exactly did this happen?",
        "hinglish": "Yeh exactly kahan hua?"
      }
    },
    {
      "key": "occurred_at",
      "type": "time_expression",
      "llm_key": "time",
      "mandatory": true,
      "group": "where_when",
      "priority": 4,
      "label": "Date & time",
      "q": {
        "en": "Around what time did it happen?",
        "hinglish": "Yeh lagbhag kitne baje hua?"
      }
    },
    {
      "key": "severity",
      "type": "enum",
      "enum": [
        "LOW",
        "MEDIUM",
        "HIGH",
        "CRITICAL"
      ],
      "mandatory": true,
      "group": "impact",
      "priority": 5,
      "label": "Severity",
      "q": {
        "en": "How serious is it right now — minor, significant, or is anyone in danger?",
        "hinglish": "Abhi situation kitni serious hai — chhoti problem, badi problem, ya kisi ki jaan ko khatra hai?"
      }
    },
    {
      "key": "injuries",
      "type": "enum",
      "enum": [
        "YES",
        "NO",
        "UNKNOWN"
      ],
      "mandatory": true,
      "group": "impact",
      "priority": 6,
      "label": "Anyone injured?",
      "q": {
        "en": "Was anyone hurt?",
        "hinglish": "Kya kisi ko chot lagi?"
      }
    },
    {
      "key": "injured_count",
      "type": "int",
      "min": 0,
      "mandatory": false,
      "group": "impact",
      "label": "Number injured"
    },
    {
      "key": "persons",
      "type": "person_list",
      "mandatory": false,
      "label": "Persons involved",
      "item": {
        "name": "string",
        "role": [
          "AFFECTED",
          "INVOLVED",
          "RESPONDER",
          "REPORTER",
          "OTHER"
        ],
        "injured": "bool",
        "injury": "string"
      }
    },
    {
      "key": "equipment",
      "type": "string_list",
      "mandatory": false,
      "group": "hazard",
      "priority": 7,
      "label": "Equipment / asset",
      "q": {
        "en": "Which machine or equipment is involved?",
        "hinglish": "Kaunsi machine ya equipment involved hai?"
      }
    },
    {
      "key": "actions_taken",
      "type": "string_list",
      "mandatory": false,
      "label": "Immediate actions taken"
    },
    {
      "key": "witnesses",
      "type": "witness_list",
      "mandatory": false,
      "label": "Witnesses",
      "item": {
        "name": "string",
        "contact": "string"
      }
    },
    {
      "key": "near_miss",
      "type": "bool",
      "mandatory": false,
      "label": "Near miss"
    },
    {
      "key": "hazard_ongoing",
      "type": "enum",
      "enum": [
        "YES",
        "NO",
        "UNKNOWN"
      ],
      "mandatory": false,
      "group": "impact",
      "label": "Hazard still present"
    },
    {
      "key": "other_incidents",
      "type": "string_list",
      "mandatory": false,
      "label": "Other incidents mentioned"
    },
    {
      "key": "lang",
      "type": "enum",
      "enum": [
        "en",
        "hinglish",
        "hi"
      ],
      "mandatory": false,
      "system": true,
      "label": "Language"
    }
  ],
  "pair_templates": [
    {
      "fields": [
        "location",
        "occurred_at"
      ],
      "en": "Where exactly did this happen, and around what time?",
      "hinglish": "Yeh kahan hua, aur lagbhag kitne baje?"
    },
    {
      "fields": [
        "injuries",
        "severity"
      ],
      "en": "Was anyone hurt, and how serious is the situation right now?",
      "hinglish": "Kya kisi ko chot lagi, aur abhi situation kitni serious hai?"
    },
    {
      "fields": [
        "incident_type",
        "description"
      ],
      "en": "Could you tell me what happened?",
      "hinglish": "Batayiye, kya hua?"
    },
    {
      "fields": [
        "fire_status",
        "evacuation_status"
      ],
      "en": "Is the fire still burning, and has the area been evacuated?",
      "hinglish": "Kya aag abhi bhi lagi hai, aur kya area khaali karwa diya gaya hai?"
    },
    {
      "fields": [
        "first_aid_given",
        "ambulance_called"
      ],
      "en": "Has first aid been given, and has an ambulance been called?",
      "hinglish": "Kya first aid diya gaya, aur kya ambulance bulayi gayi?"
    },
    {
      "fields": [
        "leak_source",
        "leak_status"
      ],
      "en": "Where is the water coming from, and is it still leaking?",
      "hinglish": "Paani kahan se aa raha hai, aur kya abhi bhi leak ho raha hai?"
    },
    {
      "fields": [
        "substance",
        "release_status"
      ],
      "en": "What gas or chemical is it, and is it still leaking?",
      "hinglish": "Kaunsi gas ya chemical hai, aur kya abhi bhi leak ho raha hai?"
    },
    {
      "fields": [
        "vehicles_involved",
        "collision_type"
      ],
      "en": "Which vehicles were involved, and what did they hit?",
      "hinglish": "Kaunsi gaadiyan involved thi, aur takkar kisse hui?"
    }
  ],
