<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.RECORD_AUDIO"/>
    <!-- Extra 2 Level B (wake word): a foreground service that listens on-device; still no INTERNET permission -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE"/>
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <!-- lets the wake word open the report screen while another app (or the home screen) is in front -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW"/>
    <queries>
        <intent><action android:name="android.intent.action.TTS_SERVICE"/></intent>
        <intent><action android:name="android.intent.action.DIAL"/></intent>
    </queries>
    <application
        android:name=".IncidentVoiceApp"
        android:label="IncidentVoice"
        android:allowBackup="false"
        android:extractNativeLibs="true"
        android:largeHeap="true"
        android:theme="@style/Theme.IncidentVoice">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
            <!-- Extra 2 Level A: app shortcut (long-press the icon) -->
            <meta-data android:name="android.app.shortcuts" android:resource="@xml/shortcuts"/>
        </activity>

        <!-- Extra 2 Level A: Quick Settings tile "Report incident" -->
        <service android:name=".quick.ReportTileService" android:exported="true" android:label="@string/quick_report"
            android:icon="@drawable/ic_report_mic" android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter><action android:name="android.service.quicksettings.action.QS_TILE"/></intent-filter>
        </service>

        <!-- Extra 2 Level B: "Hey Qalam" listener (Vosk, CPU, offline) -->
        <service android:name=".wake.WakeWordService" android:exported="false" android:foregroundServiceType="microphone"/>

        <!-- Extra 2 Level A: home-screen widget with one REPORT button -->
        <receiver android:name=".quick.ReportWidgetReceiver" android:exported="true" android:label="@string/quick_report">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE"/></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/report_widget_info"/>
        </receiver>
    </application>
</manifest>
